# Postgres connection string used by drizzle-orm / postgres.js
DATABASE_URL=postgres://user:password@localhost:5432/within_cohort_log

# Secret used to sign/encrypt the iron-session cookie. Must be 32+ characters
# (iron-session requirement). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Web Push (VAPID) keys. Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com

# Same value as VAPID_PUBLIC_KEY, exposed to the client so the browser can
# call pushManager.subscribe(). This is the public half of the key pair, not
# a secret - never do this for VAPID_PRIVATE_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
